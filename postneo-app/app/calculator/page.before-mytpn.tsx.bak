'use client';

import { useEffect, useRef, useState } from 'react';
import { ArrowLeft, ChevronDown, Check, CircleHelp, Plus, Printer, RotateCcw, Trash2, X, ExternalLink } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Switch } from '@/components/ui/switch';
import { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui/tooltip';
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { Dialog, DialogContent, DialogTitle, DialogDescription } from '@/components/ui/dialog';
import { blank, calculate, changeEnteralMode, changeMedicineMethod, decimalInput, clock, scheduleDay, firstOffset, drugs, enteralFormulas, example, formulaCheckedAt, newMedicine, numeric, type EnteralResult, type Group, type Inputs, type Medicine, type MedResult, type Result, type Issue } from '@/lib/tpn';
import { formatNumber as f } from '@/lib/format';
import {patientHeader,formatDate,nextDate,type PatientHeader} from '@/lib/patient-header';
import {NurseSheet as CalculationSheet} from '@/components/nurse-sheet';
import {calculateNutrition,type NutritionResult} from '@/lib/nutrition';
import {NutritionSummary} from '@/components/nutrition-summary';
import {BrandMark} from '@/components/brand-mark';
import {ProteinPlan} from '@/components/protein-plan';
import {FluidNeed} from '@/components/fluid-need';

const groupNames:Record<Group,string>={antibiotic:'Антибактериальные препараты',vasoactive:'Вазоактивные препараты',sedation:'Наркотические и психотропные вещества'};
function Hint({children}:{children:React.ReactNode}) {return <Tooltip><TooltipTrigger asChild><button type="button" className="help" aria-label="Пояснение"><CircleHelp size={15}/></button></TooltipTrigger><TooltipContent className="hint-popover">{children}</TooltipContent></Tooltip>;}
function Field({label,unit,value,onChange,hint,id,type='text',placeholder='—',disabled=false,error,inputMode='decimal'}:{label:string;unit?:string;value:string;onChange:(v:string)=>void;hint?:React.ReactNode;id:string;type?:string;placeholder?:string;disabled?:boolean;error?:string;inputMode?:'text'|'decimal'|'numeric'}){
 return <div className={'field'+(error&&!disabled?' field-invalid':'')}><div className="field-label"><label htmlFor={id}>{label}</label>{hint&&<Hint>{hint}</Hint>}</div><div className={'input-wrap'+(disabled?' disabled':'')}><Input id={id} value={value} type={type} inputMode={type==='text'?inputMode:undefined} onChange={e=>onChange(e.target.value)} disabled={disabled} placeholder={placeholder} autoComplete="off" aria-invalid={!!error&&!disabled} aria-describedby={error&&!disabled?id+'-error':undefined} className="number-input"/>{unit&&<span className="input-unit">{unit}</span>}</div>{error&&!disabled&&<p id={id+'-error'} className="field-error">{error}</p>}</div>;
}
function Choice({id,label,value,onChange,options,error}:{id:string;label:string;value:string;onChange:(v:string)=>void;options:{value:string;label:string}[];error?:string}){return <div className="field"><label className="field-label" id={id+'-label'}>{label}</label><Select value={value} onValueChange={onChange}><SelectTrigger id={id} aria-labelledby={id+'-label'} aria-invalid={!!error} aria-describedby={error?id+'-error':undefined} className="choice"><SelectValue placeholder="Выбрать"/></SelectTrigger><SelectContent position="popper">{options.map(x=><SelectItem key={x.value} value={x.value}>{x.label}</SelectItem>)}</SelectContent></Select>{error&&<p className="field-error" id={id+'-error'}>{error}</p>}</div>;}
function SectionTitle({title,subtitle}:{title:string;subtitle?:string}) {return <div className="section-title"><div><h2>{title}</h2>{subtitle&&<p>{subtitle}</p>}</div></div>;}
function SmallResult({label,value,unit}:{label:string;value:string;unit:string}){return <div className="small-result"><span>{label}</span><strong>{value} <small>{unit}</small></strong></div>;}

function EnteralResults({result,compact=false}:{result:EnteralResult;compact?:boolean}){
 const rows=[{key:'energyKcal' as const,label:'Калории',unit:'ккал'},{key:'proteinG' as const,label:'Белки',unit:'г'},{key:'carbohydrateG' as const,label:'Углеводы',unit:'г'},{key:'fatG' as const,label:'Жиры',unit:'г'}];
 return <div className={'enteral-results'+(compact?' compact':'')}>
 <Table><TableHeader><TableRow><TableHead>Показатель</TableHead><TableHead>За сутки</TableHead><TableHead>На кг/сут</TableHead></TableRow></TableHeader><TableBody>{rows.map(row=><TableRow key={row.key}><TableCell>{row.label}</TableCell><TableCell data-testid={compact?undefined:'enteral-daily-'+row.key}>{f(result.daily?.[row.key],3)} <span>{row.unit}</span></TableCell><TableCell data-testid={compact?undefined:'enteral-perkg-'+row.key}>{f(result.perKg?.[row.key],3)} <span>{row.unit}</span></TableCell></TableRow>)}</TableBody></Table>
 </div>;
}

function EnteralPanel({p,result,update}:{p:Inputs;result:EnteralResult;update:(patch:Partial<Inputs>)=>void}){
 const [modeError,setModeError]=useState('');
 useEffect(()=>setModeError(''),[p.weight,p.enteralMode,p.enteral,p.enteralVolume,p.feedingMl,p.feedingCount]);
 const formula=result.formula;const fieldError=(field:string)=>result.issues.find(issue=>issue.field===field)?.message;
 const changeMode=(value:string)=>{
  const transition=changeEnteralMode(p,value as Inputs['enteralMode']);
  setModeError(transition.error);
  if(transition.patch)update(transition.patch);
 };
 return <section className="panel enteral-panel" id="enteral" tabIndex={-1}><SectionTitle title="Энтеральное питание" subtitle="Калории и нутриенты из готовой смеси за 24 часа"/>
 <div className="enteral-controls"><Choice id="enteral-formula" error={fieldError('formulaId')} label="Смесь" value={p.formulaId} onChange={formulaId=>update({formulaId})} options={[{value:'none',label:'Выберите смесь'},...enteralFormulas.map(x=>({value:x.id,label:x.name}))]}/>
 <Choice id="enteral-mode" error={modeError||fieldError('enteralMode')} label="Как задать объём" value={p.enteralMode} onChange={changeMode} options={[{value:'perKg',label:'мл/кг/сут'},{value:'daily',label:'мл за сутки'},{value:'feeds',label:'Объём × кормления'}]}/></div>
 <div className="fields-grid two enteral-volume-fields">
 {p.enteralMode==='perKg'&&<Field id="input-enteral" error={fieldError('enteral')} label="Готовая смесь" unit="мл/кг/сут" value={p.enteral} onChange={enteral=>update({enteral})}/>}
 {p.enteralMode==='daily'&&<Field id="input-enteralVolume" error={fieldError('enteralVolume')} label="Готовая смесь за сутки" unit="мл/сут" value={p.enteralVolume} onChange={enteralVolume=>update({enteralVolume})}/>}
 {p.enteralMode==='feeds'&&<><Field id="input-feedingMl" error={fieldError('feedingMl')} label="На одно кормление" unit="мл" value={p.feedingMl} onChange={feedingMl=>update({feedingMl})}/><Field id="input-feedingCount" error={fieldError('feedingCount')} label="Кормлений за сутки" unit="раз" value={p.feedingCount} onChange={feedingCount=>update({feedingCount})}/></>}
 </div>
 <p className="enteral-volume-result"><strong data-testid="enteral-volume">{f(result.volumeMl,3)} мл/сут</strong><span>{f(result.volumePerKg,3)} мл/кг/сут</span></p>
 {formula&&<div className="formula-composition"><p>{formula.population}</p><p><b>На 100 мл:</b> {f(formula.per100ml.energyKcal)} ккал · белки {f(formula.per100ml.proteinG)} г · углеводы {f(formula.per100ml.carbohydrateG)} г · жиры {f(formula.per100ml.fatG)} г</p></div>}
 <EnteralResults result={result}/>
 {result.errors.length>0&&<ul className="error-list" role="status">{result.errors.map(error=><li key={error}>{error}</li>)}</ul>}
 <p className="enteral-note">Укажите объём готового питания. Он входит в баланс жидкости; белок смеси автоматически учитывается в общей цели белка.</p>
 {formula&&<details className="formula-details"><summary>Состав, разведение и источник <ChevronDown size={15}/></summary><p>{formula.proteinType}. {formula.note}</p><p>Стандартное разведение: {f(formula.powderGrams)} г порошка + 90 мл воды ≈ 100 мл готовой смеси. Используйте мерную ложку и инструкцию именно вашей упаковки.</p><p><a href={formula.source} target="_blank" rel="noreferrer">Таблица производителя <ExternalLink size={13}/></a>{formula.source!==formula.productUrl&&<a href={formula.productUrl} target="_blank" rel="noreferrer">Инструкция к продукту <ExternalLink size={13}/></a>}</p></details>}
 <details className="formula-details formula-directory"><summary>Сравнить 4 смеси <ChevronDown size={15}/></summary><p>На 100 мл готовой смеси при стандартном разведении.</p><Table><TableHeader><TableRow><TableHead>Смесь</TableHead><TableHead>ккал</TableHead><TableHead>Белки, г</TableHead><TableHead>Углеводы, г</TableHead><TableHead>Жиры, г</TableHead></TableRow></TableHeader><TableBody>{enteralFormulas.map(item=><TableRow key={item.id} data-selected={p.formulaId===item.id}><TableCell><a href={item.source} target="_blank" rel="noreferrer">{item.name}</a></TableCell><TableCell>{f(item.per100ml.energyKcal)}</TableCell><TableCell>{f(item.per100ml.proteinG)}</TableCell><TableCell>{f(item.per100ml.carbohydrateG)}</TableCell><TableCell>{f(item.per100ml.fatG)}</TableCell></TableRow>)}</TableBody></Table><p>При 150 мл/кг/сут: Пре 0 даёт 3,9 г белка/кг/сут, Пре 1 — 3,0 г, Пепти Гастро — 2,7 г, ГА 1 — 2,25 г. Это пример сравнения, не целевой объём питания.</p><p>Пепти Гастро: глубокий гидролиз; ГА 1: частичный. Смеси различаются по назначению и не взаимозаменяемы только на основании калорийности.</p></details>
 <p className="enteral-source-note">Проверено {formulaCheckedAt} по данным Nutricia. Рецептуры могут отличаться: сверяйте состав с упаковкой. Калории взяты из маркировки, без пересчёта по округлённым БЖУ. Смешанное питание и нестандартное разведение здесь не рассчитаны.</p>
 </section>;
}

function infusionTime(offset:number|null,start:string,date:string):string {
 if(offset===null)return '—';
 const day=scheduleDay(offset,start);if(day===null)return '—';
 const calendar=day===0?formatDate(date):day===1?nextDate(date):'—';
 return calendar==='—'?clock(offset,start)+(day>0?' (следующий день)':''):calendar+' '+clock(offset,start);
}

function DrugCard({m,result,update,remove,start,weight,date,nutritionIssues}:{m:Medicine;result:MedResult|undefined;nutritionIssues:Issue[];update:(patch:Partial<Medicine>)=>void;remove:()=>void;start:string;weight:string;date:string}){
 const [methodError,setMethodError]=useState('');
 useEffect(()=>setMethodError(''),[m,weight,start]);
 const changeMethod=(method:Medicine['method'])=>{
  const grams=numeric(weight);const transition=changeMedicineMethod(m,method,grams===null?NaN:grams/1000,start);
  setMethodError(transition.error);if(transition.patch)update(transition.patch);
 };
 const d=drugs.find(x=>x.id===m.drug)!;const bolus=m.mode==='intermittent';const doseUnit=bolus?(m.drug==='fentanyl'?'мкг/кг':'мг/кг'):d.unit;
 const input=(key:keyof Medicine,label:string,unit?:string,hint?:React.ReactNode,type='text')=><Field key={key} id={m.id+'-'+key} label={label} unit={unit} value={String(m[key])} onChange={v=>update({[key]:v})} hint={hint} type={type} error={result?.issues.find(x=>x.field===key)?.message??nutritionIssues.find(x=>x.field===key)?.message}/>;
 const invalid=result&&!result.valid;
 return <article id={m.id} className={'drug-card'+(invalid?' incomplete':'')}><div className="drug-heading"><div className="drug-name"><h3>{d.name}</h3><span className="drug-route">Внутривенно</span></div><Button variant="ghost" size="icon" onClick={remove} aria-label={'Удалить '+d.name}><Trash2 size={16}/></Button></div>
 <details className="dose-hint"><summary><CircleHelp size={14}/> Подсказка по дозе <ChevronDown size={14}/></summary><p>{d.hint}</p>{'source' in d&&<a href={d.source} target="_blank" rel="noreferrer">{d.sourceLabel} <ExternalLink size={12}/></a>}<p className="source-note">Для учебного расчёта. Подсказка не выбирает дозу автоматически. {'source' in d&&'Источник проверен 25.09.2026.'}</p></details>
 {m.group==='sedation'&&<Choice id={m.id+'-mode'} label="Режим введения" value={m.mode} onChange={v=>update({mode:v as Medicine['mode'],dose:'',unit:v==='intermittent'?(m.drug==='fentanyl'?'мкг/кг':'мг/кг'):d.unit,pump:'',amount:'',interval:'',minutes:''})} options={[{value:'continuous',label:'Непрерывная инфузия'},{value:'intermittent',label:'Периодические введения'}]}/>}
 <div className="drug-fields">
 {input('dose',bolus?'Разовая доза':'Дотация',doseUnit,m.drug==='ampsul'?'Расчёт по сумме ампициллина и сульбактама в соотношении 2:1.':undefined)}
 {bolus?<>{input('interval','Интервал','ч')}<Field id={m.id+'-loadingDose'} label="Нагрузочная доза" unit={m.unit.startsWith('мкг')?'мкг/кг':'мг/кг'} value={m.loading?m.loadingDose:''} onChange={v=>update({loadingDose:v})} disabled={!m.loading} placeholder="По схеме" hint="Доступна, если включён пункт о нагрузке по выбранной схеме." error={result?.issues.find(x=>x.field==='loadingDose')?.message}/>{input('first','Первое введение',undefined,'Первое введение в этих расчётных сутках. Введения до начала суток здесь не моделируются.','time')}</>:<>{input('hours','Введение за сутки','ч')}<Choice id={m.id+'-method'} label="Рассчитать по" value={m.method} error={methodError||result?.issues.find(x=>x.field==='method')?.message} onChange={v=>changeMethod(v as Medicine['method'])} options={[{value:'rate',label:'Скорости'},{value:'amount',label:'Количеству'}]}/>{m.method==='rate'?input('pump','Скорость насоса','мл/ч'):input('amount','Препарат в шприце','мг')}</>}
 </div>
 <div className="drug-fields secondary-fields">{bolus&&input('minutes','Вводить за','мин')}
 <div className="field"><label className="field-label" htmlFor={m.id+'-diluent'}>{m.loading?'Растворитель (основной и нагрузка)':'Растворитель'}</label><Input id={m.id+'-diluent'} value={m.diluent} onChange={e=>update({diluent:e.target.value,diluentNutrition:'auto',diluentGlucosePercent:''})} placeholder="По выбранной схеме"/></div>
 {input('volume',bolus?'Развести до':'Объём шприца','мл','Конечный объём раствора, включая сам препарат.')}
 {input('stock','Исходная концентрация','мг/мл',bolus?'Необязательно для баланса. Нужна для расчёта объёма препарата из флакона.':'Содержание действующего вещества в исходном растворе. Вводится по конкретной маркировке.')}
 <div className="field"><span className="field-label">Способ введения</span><span className="readonly-field">Внутривенно</span></div>
 </div>
 <details className="carrier-nutrition"><summary>Калории растворителя <ChevronDown size={14}/></summary><Choice id={m.id+'-diluentNutrition'} label="Состав для подсчёта калорий" value={m.diluentNutrition} error={nutritionIssues.find(x=>x.field==='diluentNutrition')?.message} onChange={v=>update({diluentNutrition:v as Medicine['diluentNutrition']})} options={[{value:'auto',label:'Из названия растворителя'},{value:'none',label:'Без калорий и белка'},{value:'glucose',label:'Глюкоза — задать концентрацию'}]}/>{m.diluentNutrition==='glucose'&&input('diluentGlucosePercent','Глюкоза в растворителе','%')}<p className="field-note">NaCl 0,9%, вода для инъекций и «Глюкоза N%» распознаются из названия. При другом составе укажите вариант явно. Для глюкозы нужна исходная концентрация препарата: учитывается только объём растворителя.</p></details>
 <div className="load-row"><Switch id={m.id+'-load'} checked={m.loading} onCheckedChange={v=>update({loading:v})}/><label htmlFor={m.id+'-load'}>Нагрузка предусмотрена выбранной схемой</label></div>
 {m.loading&&<div className="loading-fields"><div className="drug-fields">{!bolus&&input('loadingDose','Нагрузочная доза',m.unit.startsWith('мкг')?'мкг/кг':'мг/кг')}{input('loadingVolume','Конечный объём','мл')}{input('loadingMinutes','Вводить за','мин')}{input('loadingFirst','Время нагрузки',undefined,undefined,'time')}</div><div className={'field'+(result?.issues.some(x=>x.field==='loadingSource')?' field-invalid':'')}><label className="field-label" htmlFor={m.id+'-loadingSource'}>Источник схемы с нагрузкой</label><Input id={m.id+'-loadingSource'} value={m.loadingSource} onChange={e=>update({loadingSource:e.target.value})} placeholder="Протокол, версия или ссылка" aria-invalid={result?.issues.some(x=>x.field==='loadingSource')} aria-describedby={result?.issues.some(x=>x.field==='loadingSource')?m.id+'-source-error':undefined}/>{result?.issues.some(x=>x.field==='loadingSource')&&<p className="field-error" id={m.id+'-source-error'}>Укажите источник схемы с нагрузкой</p>}</div></div>}
 {result&&result.valid?<div className="drug-results"><SmallResult label={bolus?'На введение':'В шприце'} value={f(bolus?result.doseMg:result.amountMg,4)} unit="мг"/><SmallResult label="Концентрация раствора" value={f(result.concentration,4)} unit="мг/мл"/><SmallResult label="Скорость" value={f(result.rate,4)} unit="мл/ч"/><SmallResult label="В баланс суток" value={f(result.volume,3)} unit="мл"/>{result.stockMl!==null&&<p className="mix-note">Препарат {f(result.stockMl,4)} мл + растворитель {f(result.solventMl,4)} мл → {m.volume.replace('.',',')} мл.</p>}{bolus&&<p className="mix-note">Начало введений: {result.times.map(t=>infusionTime(t,start,date)).join(' · ')}. В баланс входит только объём до конца расчётных суток.</p>}{!bolus&&result.syringeCount!==null&&result.syringeCount>1&&<p className="mix-note">Одного шприца хватит на {f(result.syringeHours,3)} ч; за {m.hours.replace('.',',')} ч потребуется {result.syringeCount} шприца с тем же составом. В баланс включено {f(result.rate!==null&&result.duration!==null?result.rate*result.duration:null,3)} мл поддерживающей инфузии.</p>}{m.loading&&<p className="mix-note">Нагрузка с {infusionTime(firstOffset(m.loadingFirst,start),start,date)}: {f(result.loadingMg,4)} мг, {f(result.loadingVolume,3)} мл; в баланс этих суток входит {f(result.loadingDeliveredVolume,3)} мл, поступает {f(result.loadingDeliveredMg,4)} мг. Отдельно от поддерживающей дозы.</p>}</div>:<p className="form-note">{result?.errors.join(' · ')||'Для расчёта заполните массу ребёнка и параметры введения.'}</p>}
 </article>;
}

function moveBetweenFields(event:React.KeyboardEvent<HTMLDivElement>) {
 if(event.key!=='Enter'||event.nativeEvent.isComposing||event.altKey||event.ctrlKey||event.metaKey||!(event.target instanceof HTMLInputElement))return;
 const fields=Array.from(event.currentTarget.querySelectorAll<HTMLElement>('input:not(:disabled):not([readonly]),button[role=combobox]:not(:disabled)')).filter(field=>field.getClientRects().length>0);
 const current=fields.indexOf(event.target);
 if(current<0)return;
 const next=fields[current+(event.shiftKey?-1:1)];
 if(!next)return;
 event.preventDefault();
 next.focus();
 if(next instanceof HTMLInputElement&&next.type==='text')next.select();
}

function WorkspaceNavigation(){return <nav className="workspace-navigation" aria-label="Разделы расчёта">
 <div className="section-links"><a href="#patient">Ребёнок</a><a href="#enteral">Энтерально</a><a href="#additional">Доп. жидкость</a><a href="#nutrition">Белок и в/в</a><a href="#medications">Препараты</a><a href="#summary" onClick={()=>{const summary=document.getElementById('summary');summary?.scrollTo({top:0,behavior:'instant'});summary?.focus({preventScroll:true});}}>Итог</a></div>
 <span className="keyboard-hint">Enter — следующее поле · Shift + Enter — назад</span>
 </nav>;}

function Summary({p,r,header,nutrition,onIssue}:{p:Inputs;r:Result;header:PatientHeader;nutrition:NutritionResult;onIssue:(issue:Issue)=>void}) {
 const segments=[{label:'База',value:r.base,color:'var(--blue)'},{label:'Аминокислоты',value:r.aaMl,color:'var(--white)'},{label:'Жиры',value:r.fatMl,color:'var(--mint)'},{label:'Лекарства',value:r.drugMl,color:'var(--muted-foreground)'},{label:'Энтерально',value:r.enteralMl,color:'#657084'},{label:'Прочее',value:(r.other??0)+(r.flush??0),color:'#4c586d'}];
 return <aside className="summary" id="summary" tabIndex={-1}><div className="summary-head"><div><span className="eyebrow">Расчёт на 24 часа</span><h2>Общий баланс</h2></div></div><div className="total-line"><strong data-testid="total-fluid">{f(r.total)}</strong><span>мл / сутки</span></div><div className="perkg-line">{f(numeric(p.fluid))} мл/кг/сут <span>·</span> {f(r.kg,3)} кг</div>
 <div className="balance-bar" aria-label={r.valid?'Состав суточной жидкости':'Баланс ожидает исправления данных'}>{r.valid&&segments.map(s=><div key={s.label} title={s.label+': '+f(s.value)+' мл'} style={{background:s.color,width:r.total&&s.value!==null&&s.value>0?Math.min(100,s.value/r.total*100)+'%':'0%'}}/>)}</div>
 <div className={'balance-status '+(r.valid?'complete':'needs-input')}>{r.valid?<><Check size={15}/> Баланс рассчитан</>:<><CircleHelp size={15}/> Проверьте исходные данные</>}</div>
 {!r.valid&&<div className="error-summary" role="region" aria-label="Ошибки расчёта"><p>Исправьте поля, чтобы получить итоговые скорости и состав смеси.</p><ul className="error-list">{r.issues.map((issue,i)=><li key={i}><button type="button" onClick={()=>onIssue(issue)}>{issue.medicineId?(r.medicines.find(m=>m.id===issue.medicineId)?.name+': '):''}{issue.message}</button></li>)}</ul></div>}
 {!header.valid&&<div className="print-readiness" role="region" aria-label="Подготовка печати"><p>Перед печатью проверьте шапку листа.</p><button type="button" onClick={()=>onIssue(header.issues[0])}>{header.issues[0].message}</button></div>}
 <NutritionSummary result={nutrition} plan={r.proteinPlan} onIssue={onIssue}/>
 <div className="infusion-results">
 {[{name:'База',detail:'Глюкоза + кальций',volume:r.base,rate:r.baseRate,h:p.baseHours,color:'blue'},{name:'Аминокислоты',detail:r.proteinPlan.valid&&r.proteinPlan.requiredIvGrams===0?'Не требуются для заданной цели':'Раствор '+p.aaPercent.replace('.',',')+'%',volume:r.aaMl,rate:r.aaRate,h:p.aaHours,color:'white'},{name:'Жиры',detail:'Эмульсия '+p.fatPercent.replace('.',',')+'%',volume:r.fatMl,rate:r.fatRate,h:p.fatHours,color:'mint'}].map(x=><div className="infusion-result" key={x.name}>
 <div className="infusion-label"><i className={x.color}/><div><strong>{x.name}</strong><small>{x.detail}</small></div></div>
 <div className="infusion-metrics"><div><span>Объём за {x.h||'—'} ч</span><strong data-testid={x.name==='База'?'base-volume':undefined}>{x.volume!==null&&x.volume<0?'Недостаток '+f(-x.volume):f(x.volume)} <small>мл</small></strong></div><div className="infusion-rate"><span>Скорость</span><strong>{f(r.valid?x.rate:null,3)} <small>мл/ч</small></strong></div></div>
 </div>)}
 </div>
 <div className="summary-rows"><div><span>Лекарства</span><b data-testid="drug-volume">{f(r.drugMl,3)} мл</b></div><div><span>Энтеральное питание</span><b>{f(r.enteralMl)} мл</b></div><div><span>Прочее и промывки</span><b>{r.other===null||r.flush===null?'—':f(r.other+r.flush)} мл</b></div></div>
 {(r.enteralNutrition.formula||(r.enteralMl!==null&&r.enteralMl>0))&&<details className="summary-enteral"><summary>Нутриенты смеси <ChevronDown size={14}/></summary>{r.enteralNutrition.formula&&<p>{r.enteralNutrition.formula.name}</p>}<EnteralResults result={r.enteralNutrition} compact/></details>}
 <div className="concentration-box"><span>Глюкоза в готовой базе <Hint>Концентрация после добавления кальция. Глюкоза растворителей лекарств здесь не учитывается.</Hint></span><strong data-testid="glucose-concentration">{f(r.valid?r.glucosePercent:null,2)}<small> %</small></strong></div>
 <div className="gir-result"><span>Глюкоза базы во время инфузии</span><strong data-testid="actual-gir">{f(r.valid?r.actualGir:null,3)} <small>мг/кг/мин</small></strong><p>Средняя за 24 часа: {f(numeric(p.gir),3)} мг/кг/мин</p></div>
 <p className="summary-foot">Дозы задаёт врач. Этот прототип проверяет арифметику и баланс, а не клиническую применимость назначения.</p>
 </aside>;
}

export default function Home(){
 const sequence=useRef(0);const printTrigger=useRef<HTMLButtonElement>(null);const printReturnIssue=useRef<Issue|null>(null);const [p,setP]=useState<Inputs>(example);const [tab,setTab]=useState('antibiotic');const [picker,setPicker]=useState('');const [notice,setNotice]=useState('');const [printOpen,setPrintOpen]=useState(false);const [printDetails,setPrintDetails]=useState(false);const r=calculate(p);const nutrition=calculateNutrition(p,r);const header=patientHeader(p);const printReady=r.valid&&header.valid;const live=useRef({p,r});live.current={p,r};
 const set=(key:keyof Inputs,value:string)=>setP(old=>({...old,[key]:value,...(key==='fatPercent'&&value!==old.fatPercent?{fatKcalPer100Ml:''}:{})}));
 const input=(key:keyof Inputs,label:string,unit?:string,hint?:React.ReactNode,type='text',disabled=false)=><Field key={key} id={'input-'+key} label={label} unit={unit} value={String(p[key])} onChange={v=>set(key,v)} hint={hint} type={type} disabled={disabled} inputMode={['surname','historyNumber'].includes(key)?'text':'decimal'} error={r.issues.find(x=>!x.medicineId&&x.field===key)?.message??header.issues.find(x=>x.field===key)?.message??nutrition.issues.find(x=>!x.medicineId&&x.field===key)?.message}/>;
 const focusIssue=(issue:Issue)=>{const isMedicine=issue.medicineId&&!['weight','start'].includes(issue.field);if(isMedicine){const medicine=p.medicines.find(m=>m.id===issue.medicineId);if(medicine&&medicine.group!==tab){setTab(medicine.group);setPicker('');}}requestAnimationFrame(()=>requestAnimationFrame(()=>{const element=document.getElementById(isMedicine?issue.medicineId+'-'+issue.field:issue.field==='formulaId'?'enteral-formula':issue.field==='enteralMode'?'enteral-mode':'input-'+issue.field);if(!element)return;for(let parent=element.parentElement;parent;parent=parent.parentElement)if(parent instanceof HTMLDetailsElement)parent.open=true;element.focus({preventScroll:true});element.scrollIntoView({block:'center',behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}));};
 const add=(id:string)=>{if(!drugs.some(drug=>drug.id===id&&drug.group===tab))return;const nextId='med-'+(++sequence.current);setP(s=>{const at=/^\d{2}:\d{2}$/.test(s.start)?s.start:'00:00';return {...s,medicines:[...s.medicines,{...newMedicine(id,nextId),first:at,loadingFirst:at}]};});setPicker('');requestAnimationFrame(()=>requestAnimationFrame(()=>{const field=document.getElementById(nextId+'-dose');if(!field)return;field.focus({preventScroll:true});field.scrollIntoView({block:'center',behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});}));};
 const removeMedicine=(id:string)=>{
  const medicine=p.medicines.find(m=>m.id===id);if(!medicine)return;
  const group=p.medicines.filter(m=>m.group===medicine.group),index=group.findIndex(m=>m.id===id);
  const neighbour=group[index+1]??group[index-1];
  setP(old=>({...old,medicines:old.medicines.filter(m=>m.id!==id)}));
  requestAnimationFrame(()=>requestAnimationFrame(()=>{
   const element=document.getElementById(neighbour?neighbour.id+'-dose':'picker-'+medicine.group);
   element?.focus({preventScroll:true});element?.scrollIntoView({block:'center',behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
  }));
 };
 useEffect(()=>{if(!notice)return;const timer=setTimeout(()=>setNotice(''),3500);return()=>clearTimeout(timer);},[notice]);
 useEffect(()=>{
  const context=(document as Document & {modelContext?:{registerTool:(tool:unknown,options?:unknown)=>unknown}}).modelContext;if(!context?.registerTool)return;
  const lifecycle=new AbortController();
  const register=(tool:unknown)=>{try{Promise.resolve(context.registerTool(tool,{signal:lifecycle.signal})).catch(()=>{});}catch{}};
  register({name:'get_tpn_calculation',title:'Прочитать расчёт питания',description:'Возвращает текущие введённые значения и арифметический результат учебного калькулятора. Не подтверждает клиническую пригодность.',inputSchema:{type:'object',properties:{},additionalProperties:false},annotations:{readOnlyHint:true},execute:()=>({inputs:live.current.p,result:live.current.r,nutrition:calculateNutrition(live.current.p,live.current.r)})});
  register({name:'set_tpn_inputs',title:'Изменить параметры питания',description:'Изменяет числовые поля, видимые в учебном калькуляторе, и пересчитывает баланс. Не назначает препараты.',inputSchema:{type:'object',properties:{values:{type:'object',properties:Object.fromEntries(['weight','day','gestation','fluid','enteral','other','flush','aa','aaPercent','aaHours','fat','fatPercent','fatHours','gir','baseHours','calcium','calciumContent','lowGlucose','highGlucose'].map(k=>[k,{type:'number',minimum:0,...(k==='aa'?{description:'Общая цель белка: энтерально + внутривенно, г/кг/сут'}:{})}])),additionalProperties:false}},required:['values'],additionalProperties:false},annotations:{readOnlyHint:false},execute:async(input:unknown)=>{const values=(input as {values?:Record<string,unknown>})?.values;const allowed=['weight','day','gestation','fluid','enteral','other','flush','aa','aaPercent','aaHours','fat','fatPercent','fatHours','gir','baseHours','calcium','calciumContent','lowGlucose','highGlucose'];if(!values||typeof values!=='object'||Array.isArray(values)||Object.entries(values).some(([k,v])=>!allowed.includes(k)||typeof v!=='number'||!Number.isFinite(v)||v<0))throw new Error('Нужны допустимые числовые поля');const next:Inputs={...live.current.p,...Object.fromEntries(Object.entries(values).map(([k,v])=>[k,decimalInput(v as number)])),...(Object.prototype.hasOwnProperty.call(values,'enteral')?{enteralMode:'perKg' as const}:{}),...(Object.prototype.hasOwnProperty.call(values,'fatPercent')&&String(values.fatPercent)!==live.current.p.fatPercent?{fatKcalPer100Ml:''}:{})};setP(next);await new Promise<void>(resolve=>requestAnimationFrame(()=>requestAnimationFrame(()=>resolve())));return {result:calculate(next)};}});
  register({name:'get_enteral_formulas',title:'Состав энтеральных смесей',description:'Четыре смеси Nutrilon: значения на 100 мл готовой смеси, ссылки на производителя и дата проверки.',inputSchema:{type:'object',properties:{},additionalProperties:false},annotations:{readOnlyHint:true},execute:()=>({checkedAt:formulaCheckedAt,basis:'100 мл готовой смеси при стандартном разведении',formulas:enteralFormulas})});
  register({name:'set_enteral_feeding',title:'Рассчитать энтеральное питание',description:'Выбирает смесь и введённый пользователем объём. Выводит калории, белки, углеводы и жиры за сутки и на кг. Не выбирает питание и объём за врача.',inputSchema:{type:'object',properties:{formulaId:{type:'string',enum:enteralFormulas.map(x=>x.id)},mode:{type:'string',enum:['perKg','daily','feeds']},volume:{type:'number',minimum:0,description:'Готовая смесь: мл/кг/сут для perKg, мл/сут для daily, мл/кормление для feeds'},feedings:{type:'integer',minimum:1,maximum:48}},required:['formulaId','mode','volume'],additionalProperties:false},annotations:{readOnlyHint:false},execute:async(input:unknown)=>{const value=input as {formulaId?:string;mode?:string;volume?:number;feedings?:number};if(!value||!enteralFormulas.some(x=>x.id===value.formulaId)||!['perKg','daily','feeds'].includes(value.mode??'')||typeof value.volume!=='number'||!Number.isFinite(value.volume)||value.volume<0)throw new Error('Укажите смесь, способ ввода и неотрицательный объём');if(value.mode==='feeds'&&(!Number.isInteger(value.feedings)||value.feedings!<1||value.feedings!>48))throw new Error('Укажите целое число кормлений от 1 до 48');const next:Inputs={...live.current.p,formulaId:value.formulaId!,enteralMode:value.mode as Inputs['enteralMode'],...(value.mode==='perKg'?{enteral:decimalInput(value.volume)}:value.mode==='daily'?{enteralVolume:decimalInput(value.volume)}:{feedingMl:decimalInput(value.volume),feedingCount:String(value.feedings)})};setP(next);await new Promise<void>(resolve=>requestAnimationFrame(()=>requestAnimationFrame(()=>resolve())));const result=calculate(next);return {enteral:result.enteralNutrition,balance:result};}});
  return()=>lifecycle.abort();
 },[]);
 return <TooltipProvider delayDuration={180}><div className="app-shell"><header className="topbar"><a href="/" className="brand" aria-label="POSTNEO — главная"><BrandMark/><span className="brand-divider"/><span className="brand-caption">Калькулятор</span></a><a href="/" className="calculator-home-link"><ArrowLeft size={15} aria-hidden="true"/>Главная</a><span className="version-label">Учебная версия 0.2</span></header>
 <main className="workspace"><div className="page-heading"><div><p className="eyebrow">Неонатология · Питание и инфузионная терапия</p><h1>Калькулятор питания</h1></div><div className="page-actions"><Button variant="outline" onClick={()=>{setP(example());setTab('antibiotic');setPicker('');setNotice('Учебный пример загружен');}}><RotateCcw size={15}/>Учебный пример</Button><Button variant="ghost" onClick={()=>{setP(blank());setTab('antibiotic');setPicker('');setNotice('Поля очищены');}} className="clear-button">Очистить</Button><Button ref={printTrigger} variant="outline" onClick={()=>setPrintOpen(true)} aria-label="Предпросмотр и печать расчёта"><Printer size={16}/><span className="print-label">Печать / PDF</span></Button></div></div>
 <div className="study-banner"><p>Учебный прототип. <span>Не использовать как готовый лист назначений: дозы, совместимость и разведения требуют клинической проверки.</span></p></div>
 <WorkspaceNavigation/><div className="calculator-grid"><div className="editor" onKeyDown={moveBetweenFields}>
 <section className="panel" id="patient" tabIndex={-1}><SectionTitle title="Данные ребёнка"/>
 <details className="patient-document" open><summary><span>Шапка печатного листа</span><span className={header.valid?'document-complete':'document-incomplete'}>{header.valid?'Реквизиты заполнены':'Заполните перед печатью'}</span><ChevronDown size={16}/></summary>
 <div className="fields-grid document-fields">{input('surname','Фамилия')}{input('historyNumber','Номер истории')}{input('birthDate','Дата рождения',undefined,undefined,'date')}<Choice id="input-sex" label="Пол" value={p.sex} onChange={v=>set('sex',v)} error={header.issues.find(x=>x.field==='sex')?.message} options={[{value:'male',label:'Мужской'},{value:'female',label:'Женский'},{value:'undetermined',label:'Не определён'}]}/>{input('sheetDate','Дата листа',undefined,undefined,'date')}{input('hospitalDay','Койко-день','день','Вводится отдельно: день пребывания в стационаре может отличаться от суток жизни.')}
 <Choice id="input-pcvMode" label="Как задать ПКВ" value={p.pcvMode} onChange={v=>setP(old=>({...old,pcvMode:v as Inputs['pcvMode'],...(v==='manual'&&header.pcv&&!old.pcvWeeks.trim()&&!old.pcvDays.trim()?{pcvWeeks:String(header.pcv.weeks),pcvDays:String(header.pcv.days)}:{})}))} error={header.issues.find(x=>x.field==='pcvMode')?.message} options={[{value:'auto',label:'Рассчитать автоматически'},{value:'manual',label:'Ввести вручную'}]}/>
 {p.pcvMode==='auto'?<div className="field"><div className="field-label"><span>ПКВ</span><Hint>Гестация при рождении + сутки жизни − 1 день. Первые сутки жизни соответствуют дню рождения. ПКВ — постконцептуальный возраст.</Hint></div><output className="readonly-field" data-testid="pcv">{header.pcv?`${header.pcv.weeks} нед ${header.pcv.days} дн`:'Укажите гестацию и сутки жизни'}</output></div>:<div className="pcv-manual-fields">{input('pcvWeeks','ПКВ: недели','нед')}{input('pcvDays','ПКВ: дни','дн')}</div>}
 </div></details><div className="fields-grid patient-fields">{input('weight','Расчётная масса','г')}{input('day','Сутки жизни','сут')}{input('gestation','Гестация при рождении','нед')}{input('gestationDays','Дни гестации','дн','Дополнительные дни при рождении: от 0 до 6. Например, 30 нед 4 дн вводятся в два отдельных поля.')}{input('fluid','Общая жидкость','мл/кг/сут')}{input('start','Начало расчётных суток',undefined,undefined,'time')}</div><FluidNeed weightGrams={numeric(p.weight)} day={numeric(p.day)} fluid={numeric(p.fluid)} onPick={value=>set('fluid',String(value))}/></section>
 <EnteralPanel p={p} result={r.enteralNutrition} update={patch=>setP(old=>({...old,...patch}))}/>
 <section className="panel" id="additional" tabIndex={-1}><SectionTitle title="Дополнительная жидкость"/><div className="fields-grid two">{input('flush','Промывки линий','мл/сут','Задаются отдельно. Объёмы лекарственных растворов уже учтены в блоке препаратов.')}{input('other','Прочие растворы и носители','мл/сут')}</div><p className="field-note">Не добавляйте сюда объёмы, уже учтённые в питании или препаратах.</p>{numeric(p.other)!==0&&<div className="additional-nutrition"><h3>Состав прочих растворов</h3><div className="fields-grid two">{input('otherKcalPer100Ml','Калорийность','ккал/100 мл')}{input('otherProteinPer100Ml','Белок','г/100 мл')}</div><p className="field-note">По составу раствора. Для жидкости без нутриентов введите 0 в оба поля.</p></div>}{numeric(p.flush)!==0&&<div className="additional-nutrition"><h3>Состав промывок</h3><div className="fields-grid two">{input('flushKcalPer100Ml','Калорийность','ккал/100 мл')}{input('flushProteinPer100Ml','Белок','г/100 мл')}</div><p className="field-note">По составу раствора. Для NaCl или воды введите 0 в оба поля.</p></div>}</section>
 <section className="panel" id="nutrition" tabIndex={-1}><SectionTitle title="Питание: цель белка и инфузии" subtitle="Общий белок — из смеси и внутривенного питания"/>
 <div className="nutrient-row protein-goal-row"><div className="nutrient-name"><i className="white"/><h3>Баланс белка</h3><span>Энтерально + внутривенно</span></div><p className="protein-goal-help">Общая цель сохраняется при изменении кормления. Больше белка из смеси — меньше аминокислот в/в; меньше из смеси — больше в/в.</p><div className="fields-grid three">{input('aa','Общая цель белка','г/кг/сут','Задайте суммарный белок за сутки, например 3,5 или 4 г/кг/сут. При расширении или сокращении кормления цель сохраняется; меняется только недостающее количество аминокислот в/в.')}{input('aaPercent','Раствор аминокислот','%','Содержание аминокислот по выбранному препарату.','text',r.proteinPlan.valid&&r.proteinPlan.requiredIvGrams===0)}{input('aaHours','Введение аминокислот','ч',undefined,'text',r.proteinPlan.valid&&r.proteinPlan.requiredIvGrams===0)}</div><ProteinPlan plan={r.proteinPlan}/>{r.proteinPlan.valid&&r.proteinPlan.requiredIvGrams!==0&&<div className="inline-result"><span>Раствор для восполнения в/в:</span><span>{f(r.aaGrams,3)} г/сут</span><span aria-hidden="true">·</span><strong data-testid="amino-volume">{f(r.valid?r.aaMl:null,3)} мл</strong><span>· {f(r.valid?r.aaRate:null,3)} мл/ч</span></div>}</div>
 <div className="nutrient-row"><div className="nutrient-name"><i className="mint"/><h3>Жиры</h3><span>Концентрация по выбранной эмульсии</span></div><div className="fields-grid three">{input('fat','Доза','г/кг/сут')}{input('fatPercent','Эмульсия','%')}{input('fatHours','Длительность','ч','Скорость рассчитывается из суточного объёма и указанной длительности; по умолчанию 24 часа.')}</div><div className="inline-result"><span>{f(r.fatGrams,3)} г/сут</span><span aria-hidden="true">·</span><strong>{f(r.fatMl,3)} мл</strong><span>· {f(r.valid?r.fatRate:null,3)} мл/ч</span></div></div>
 <div className="nutrient-row"><div className="nutrient-name"><i className="blue"/><h3>База</h3><span>Глюкоза + кальций</span></div><div className="fields-grid two">{input('gir','Глюкоза базы','мг/кг/мин','Средняя дотация глюкозы базы за 24 часа. Углеводы из других лекарственных растворов здесь не учитываются.')}{input('baseHours','Длительность','ч','Изменение длительности меняет скорость, сохраняя суточное количество глюкозы.')}</div><div className="inline-result"><span>{f(r.glucoseGrams,3)} г/сут</span><span aria-hidden="true">·</span><strong>{f(r.base,3)} мл базы</strong></div>
 <div className="electrolyte-box"><div className="subsection-label"><h4>Кальций</h4><span>Содержание по маркировке препарата</span></div><div className="fields-grid two">{input('calcium','Дотация Ca²⁺','ммоль/кг/сут')}{input('calciumContent','Содержание Ca²⁺','ммоль/мл',<>Для учебного примера Б. Браун: 2,25 ммоль на 10 мл = 0,225 ммоль/мл. Для другого препарата введите его содержание по инструкции.</>)}</div><p className="field-note">{f(r.calciumMmol,3)} ммоль/сут → <b>{f(r.caMl,3)} мл</b> в составе базы. <a href="https://www.medicines.org.uk/emc/product/15226/smpc" target="_blank" rel="noreferrer">Источник примера</a></p></div>
 <details className="mix-details" open><summary>Состав глюкозной смеси <ChevronDown size={16}/></summary><div className="fields-grid two">{input('lowGlucose','Раствор меньшей концентрации','%','0% означает раствор без глюкозы. Состав и совместимость выбираются отдельно.')}{input('highGlucose','Раствор большей концентрации','%')}</div><div className="mixture"><div><b>{f(r.valid?r.lowMl:null,3)} мл</b><span>Глюкоза {p.lowGlucose.replace('.',',')}%</span></div><span>+</span><div><b>{f(r.valid?r.highMl:null,3)} мл</b><span>Глюкоза {p.highGlucose.replace('.',',')}%</span></div><span>+</span><div><b>{f(r.valid?r.caMl:null,3)} мл</b><span>Кальций</span></div></div><p className="field-note">При введении за {p.baseHours||'—'} ч дотация глюкозы базы во время инфузии: {f(r.valid?r.actualGir:null,3)} мг/кг/мин. Совместимость смеси не оценена.</p></details></div>
 <details className="energy-settings" open><summary>Калорийность выбранных растворов <ChevronDown size={14}/></summary><div className="fields-grid three">{input('glucoseKcalPerGram','Глюкоза','ккал/г','По инструкции вашего раствора: 4 ккал/г безводной глюкозы либо 3,4 ккал/г гидратированной декстрозы. Применяется к базе и глюкозным растворителям.')}{input('aminoKcalPerGram','Аминокислоты','ккал/г','В учебном примере 4 ккал/г по Аминовен Инфант 10%.')}{input('fatKcalPer100Ml','Жировая эмульсия','ккал/100 мл','Калорийность полного раствора по этикетке. В примере: СМОФлипид 20% — 200 ккал/100 мл. При смене концентрации поле очищается.')}</div><p className="field-note">Уточните по маркировке конкретных препаратов. <a href="https://base-donnees-publique.medicaments.gouv.fr/medicament/67639553/extrait" target="_blank" rel="noreferrer">Глюкоза</a> · <a href="https://cima.aemps.es/cima/dochtml/ft/59628/FichaTecnica_59628.html" target="_blank" rel="noreferrer">Аминокислоты</a> · <a href="https://www.fresenius-kabi.com/in/products/parenteralnutrition/smoflipid" target="_blank" rel="noreferrer">Эмульсия</a></p></details>
 </section>
 <section className="panel medication-panel" id="medications" tabIndex={-1}><SectionTitle title="Препараты" subtitle="Конечные объёмы автоматически входят в суточный баланс"/><Tabs value={tab} onValueChange={v=>{setTab(v);setPicker('');}}><TabsList className="drug-tabs"><TabsTrigger value="antibiotic">Антибиотики {p.medicines.some(x=>x.group==='antibiotic')&&<span>{p.medicines.filter(x=>x.group==='antibiotic').length}</span>}</TabsTrigger><TabsTrigger value="vasoactive">Вазоактивные {p.medicines.some(x=>x.group==='vasoactive')&&<span>{p.medicines.filter(x=>x.group==='vasoactive').length}</span>}</TabsTrigger><TabsTrigger value="sedation">Наркотические и психотропные {p.medicines.some(x=>x.group==='sedation')&&<span>{p.medicines.filter(x=>x.group==='sedation').length}</span>}</TabsTrigger></TabsList>
 {(['antibiotic','vasoactive','sedation'] as Group[]).map(group=><TabsContent key={group} value={group}><h3 className="group-title">{groupNames[group]}</h3><div className="add-drug"><Choice id={'picker-'+group} label="Выбрать препарат" value={picker} onChange={setPicker} options={drugs.filter(x=>x.group===group).map(x=>({value:x.id,label:x.name}))}/><Button onClick={()=>add(picker)} disabled={!drugs.some(drug=>drug.id===picker&&drug.group===group)} className="add-button"><Plus size={17}/>Добавить</Button></div>{p.medicines.filter(x=>x.group===group).length===0&&<div className="empty-drugs"><p>Препараты не добавлены</p><span>Выберите препарат — откроются поля введения.</span></div>}{p.medicines.filter(x=>x.group===group).map(m=><DrugCard key={m.id} m={m} result={r.medicines.find(x=>x.id===m.id)} start={p.start} weight={p.weight} date={p.sheetDate} nutritionIssues={nutrition.issues.filter(issue=>issue.medicineId===m.id)} update={patch=>setP(old=>({...old,medicines:old.medicines.map(x=>x.id===m.id?{...x,...patch}:x)}))} remove={()=>removeMedicine(m.id)}/>)}</TabsContent>)}
 </Tabs></section>
 </div><Summary p={p} r={r} header={header} nutrition={nutrition} onIssue={focusIssue}/></div>
 <footer className="footer"><span>POSTNEO <span className="footer-dot">/</span> Рабочий прототип</span><span>Промежуточные расчёты без округления · значения на экране округлены</span></footer></main>
 <div className="print-document"><CalculationSheet p={p} r={r} header={header} includeDetails={printDetails}/></div>
 <Dialog open={printOpen} onOpenChange={setPrintOpen}><DialogContent className="print-preview" showCloseButton={false} onCloseAutoFocus={event=>{event.preventDefault();const issue=printReturnIssue.current;printReturnIssue.current=null;if(issue)focusIssue(issue);else printTrigger.current?.focus({preventScroll:true});}}><div className="print-preview-head"><div><DialogTitle>Предпросмотр печатного листа</DialogTitle><DialogDescription>{printReady?'Проверьте шапку, состав и все препараты перед печатью.':!header.valid?'Заполните обязательные реквизиты шапки перед печатью.':'Расчёт неполный. Исправьте отмеченные поля перед печатью.'}</DialogDescription></div><Button variant="ghost" size="icon" onClick={()=>setPrintOpen(false)} aria-label="Закрыть предпросмотр"><X size={18}/></Button></div><div className="print-preview-options"><Switch id="print-details" checked={printDetails} onCheckedChange={setPrintDetails}/><label htmlFor="print-details">Добавить подробный расчёт и источники</label><small>Рабочий лист + оборот · A4 альбомный</small></div><div className="print-preview-body"><CalculationSheet p={p} r={r} header={header} includeDetails={printDetails}/></div><div className="print-preview-actions"><Button variant="outline" onClick={()=>{printReturnIssue.current=!printReady?(!header.valid?header.issues[0]:r.issues[0])??null:null;setPrintOpen(false);}}>{printReady?'Вернуться к расчёту':'Исправить первую ошибку'}</Button><Button disabled={!printReady} onClick={()=>window.print()}><Printer size={16}/>Печать / PDF</Button></div></DialogContent></Dialog>
 <a href="#summary" className="mobile-balance"><span>{r.valid?'Баланс за сутки':'Расчёт неполный'}</span><strong>{f(r.total)} мл <ChevronDown size={15}/></strong></a>{notice&&<div className="toast" role="status"><Check size={16}/>{notice}<button onClick={()=>setNotice('')} aria-label="Закрыть"><X size={15}/></button></div>}
 </div></TooltipProvider>;
}
